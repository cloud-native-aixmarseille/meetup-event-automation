{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": [
				"tests/**/*.{spec,test}.ts",
				"tests/integration/github-actions/wait-for-synthetic-issue.mjs"
			],
			"project": ["tests/**/*.ts", "tests/**/*.mjs"]
		},
		"packages/domain/communication": {
			"entry": ["src/**/*.test.ts"],
			"project": ["src/**/*.ts"]
		},
		"packages/domain/*": {
			"entry": ["src/**/*.test.ts"],
			"project": ["src/**/*.ts"]
		},
		"packages/application/browser-authentication": {
			"entry": [],
			"project": ["src/**/*.ts"]
		},
		"packages/application/*": {
			"entry": ["src/**/*.test.ts"],
			"project": ["src/**/*.ts", "testing/**/*.ts"]
		},
		"packages/adapter/*": {
			"entry": ["src/**/*.test.ts"],
			"project": ["src/**/*.ts"]
		},
		"packages/runtime/github-actions": {
			"entry": ["src/entrypoints/*.ts", "**/*.test.ts"],
			"project": ["src/**/*.ts", "packaging/**/*.{mjs,ts}"]
		},
		"packages/domain/event": {
			"entry": ["src/**/*.test.ts"],
			"project": ["src/**/*.ts", "testing/**/*.ts"]
		},
		"packages/domain/referential": {
			"entry": ["src/**/*.test.ts"],
			"project": ["src/**/*.ts", "testing/**/*.ts"]
		},
		"packages/presentation/*": {
			"entry": ["src/**/*.test.ts"],
			"project": ["src/**/*.ts", "testing/**/*.ts"]
		}
	},
	"ignoreDependencies": ["@commitlint/config-conventional"]
}
