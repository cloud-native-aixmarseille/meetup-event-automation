{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/pnpm-lock.yaml",
			"!!**/dist",
			"!!.github/logo.svg",
			"!!.github/social-preview.svg"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/**/src/**/*.ts", "!**/*.test.ts", "!**/*.spec.ts"],
			"linter": {
				"rules": {
					"complexity": {
						"noStaticOnlyClass": "off",
						"noExcessiveCognitiveComplexity": {
							"level": "error",
							"options": {
								"maxAllowedComplexity": 15
							}
						},
						"noExcessiveLinesPerFunction": {
							"level": "error",
							"options": {
								"maxLines": 60,
								"skipBlankLines": true
							}
						}
					},
					"style": {
						"noExcessiveLinesPerFile": {
							"level": "error",
							"options": {
								"maxLines": 300,
								"skipBlankLines": true
							}
						},
						"noExcessiveClassesPerFile": {
							"level": "error",
							"options": {
								"maxClasses": 1
							}
						}
					}
				}
			}
		}
	]
}
